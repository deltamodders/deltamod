{
  "compilerOptions": {
    "allowJs": true,
    //"checkJs": true,
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "noImplicitAny": true,
    "outDir": "./dist/node",
    "rootDir": "./node",
    "sourceMap": true,
    "strictNullChecks": true,
    "target": "es2022",
  },
  "include": ["./node/**/*"],
}
