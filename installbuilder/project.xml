<project>
    <shortName>deltamod</shortName>
    <fullName>Deltamod</fullName>
    <version>2.0.3</version>
    <leftImage>${build_project_directory}/../build/installer/leftImage.png</leftImage>
    <logoImage>${build_project_directory}/../build/icon-small.png</logoImage>
    <allowLanguageSelection>1</allowLanguageSelection>
    <componentList>
        <component name="default">
            <description>Default Component</description>
            <canBeEdited>1</canBeEdited>
            <selected>1</selected>
            <show>1</show>
            <desktopShortcutList>
                <shortcut>
                    <comment>Deltarune mod manager</comment>
                    <exec></exec>
                    <icon></icon>
                    <name>Deltamod</name>
                    <path></path>
                    <platforms>all</platforms>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}\win-unpacked\Deltamod.exe</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon></windowsIcon>
                    <windowsPath></windowsPath>
                </shortcut>
            </desktopShortcutList>
            <folderList>
                <folder destination="${installdir}" name="programfiles">
                    <description>Program Files</description>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <origin>${build_project_directory}/../dist/win-unpacked</origin>
                        </distributionDirectory>
                    </distributionFileList>
                    <shortcutList>
                        <shortcut>
                            <comment>Uninstall</comment>
                            <exec>${installdir}/${uninstallerName}</exec>
                            <icon></icon>
                            <name>Uninstall ${product_fullname}</name>
                            <path>${installdir}</path>
                            <platforms>all</platforms>
                            <runAsAdmin>0</runAsAdmin>
                            <runInTerminal>0</runInTerminal>
                            <windowsExec>${installdir}/${uninstallerName}.exe</windowsExec>
                            <windowsExecArgs></windowsExecArgs>
                            <windowsIcon></windowsIcon>
                            <windowsPath>${installdir}</windowsPath>
                        </shortcut>
                    </shortcutList>
                </folder>
                <folder destination="${installdir}" name="programfileslinux">
                    <description>Program Files</description>
                    <platforms>linux</platforms>
                </folder>
                <folder destination="${installdir}" name="programfileslinux64">
                    <description>Program Files</description>
                    <platforms>linux-x64</platforms>
                </folder>
                <folder destination="${windows_folder_local_appdata}" name="programfileswindows">
                    <description>Program Files</description>
                    <platforms>windows</platforms>
                </folder>
                <folder destination="${windows_folder_local_appdata}" name="programfileswindows64">
                    <description>Program Files</description>
                    <platforms>windows-x64</platforms>
                </folder>
                <folder destination="${installdir}" name="programfilesosx">
                    <description>Program Files</description>
                    <platforms>osx</platforms>
                </folder>
            </folderList>
            <startMenuShortcutList>
                <startMenuShortcut>
                    <comment>Uninstall ${product_fullname}</comment>
                    <name>Uninstall ${product_fullname}</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/${uninstallerName}.exe</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon></windowsIcon>
                    <windowsPath>${installdir}/</windowsPath>
                </startMenuShortcut>
                <startMenuShortcut>
                    <comment></comment>
                    <name>Deltamod</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}\win-unpacked\Deltamod.exe</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon></windowsIcon>
                    <windowsPath></windowsPath>
                </startMenuShortcut>
            </startMenuShortcutList>
        </component>
    </componentList>
    <addQtMode>1</addQtMode>
    <compressionAlgorithm>lzma</compressionAlgorithm>
    <disableSplashScreen>1</disableSplashScreen>
    <enableRollback>1</enableRollback>
    <enableTimestamp>1</enableTimestamp>
    <vendor>Deltamodders</vendor>
    <finalPageActionList>
        <runProgram>
            <explanation>Open Deltamod</explanation>
            <program>${installdir}\win-unpacked\deltamod.exe</program>
            <programArguments></programArguments>
            <run>${rundmod}</run>
        </runProgram>
    </finalPageActionList>
    <parameterList>
        <directoryParameter>
            <name>installdir</name>
            <title>Install directory</title>
            <description></description>
            <explanation>Choose the directory where you wish to install Deltamod.</explanation>
            <value></value>
            <default>${windows_folder_local_appdata}\${product_shortname}</default>
            <allowEmptyValue>0</allowEmptyValue>
            <cliOptionName>prefix</cliOptionName>
            <mustBeWritable>0</mustBeWritable>
            <mustExist>0</mustExist>
            <width>60</width>
        </directoryParameter>
        <licenseParameter>
            <name>License</name>
            <title>License Agreement</title>
            <description>Please read the following License Agreement. You must accept the terms of this agreement before continuing with the installation.</description>
            <explanation></explanation>
            <file>${build_project_directory}/../LICENSE.txt</file>
            <fileEncoding>utf-8</fileEncoding>
            <htmlFile></htmlFile>
        </licenseParameter>
    </parameterList>
    <platformOptionsList>
        <platformOptions>
            <platform>windows</platform>
        </platformOptions>
    </platformOptionsList>
    <slideShowImageList>
        <slideShowImage>
            <path>${build_project_directory}/../build/installer/slide.png</path>
        </slideShowImage>
    </slideShowImageList>
</project>

