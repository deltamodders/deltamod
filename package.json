{
  "name": "deltamod",
  "version": "2.1.1",
  "description": "Deltarune mod manager",
  "main": "node/Runner.js",
  "discordAPI": "https://discord.com/api/guilds/1390331292993982484/widget.json",
  "featureFlags": [
    "GB-OneClick"
  ],
  "scripts": {
    "test": "electron . --developer",
    "build-windows": "electron-builder --win --publish never",
    "build-win32": "electron-builder --win --ia32 --publish never",
    "build-linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.deltamod.app",
    "productName": "Deltamod",

    "icon": "build/icon-big.png",

    "asar": false,

    "asarUnpack": [
      "node_modules/7zip-bin/win/**",
      "node_modules/7zip-bin/linux/**",
      "node_modules/7zip-bin/mac/**",
      "node_modules/7zip-bin/7x.sh",
      "gm3p/**"
    ],

    "files": [
      "!**/output/**",
      "!**/installbuilder/**",
      "!G3MToolCLI/**"
    ],

    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },

    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Deltamod-Setup.${ext}"
    },

    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon-big.png",
      "artifactName": "Deltamod-AppImage.${ext}"
    },

    "protocols": [
      {
        "name": "Deltamod",
        "schemes": [
          "deltamod"
        ]
      }
    ]
  },
  "author": "Deltamodders",
  "license": "EUPL-1.2",
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "@chainsafe/xdelta3-node": "^1.0.2",
    "@sentry/node": "^10.43.0",
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "7zip-bin": "5.1.1",
    "7zip-min": "^2.1.0",
    "axios": "^1.18.0",
    "cheerio": "^1.1.2",
    "create-desktop-shortcuts": "^1.11.1",
    "emit-keypress": "^1.0.1",
    "express": "^5.2.1",
    "mime-types": "^3.0.1",
    "node-html-parser": "^7.0.1",
    "node-pty": "^1.1.0",
    "nodejs": "^0.0.0",
    "nodejs-file-downloader": "^4.13.0",
    "smol-toml": "^1.7.1",
    "windows-elevate": "^1.0.1",
    "xml-js": "^1.6.11",
    "yoctocolors-cjs": "^2.1.3"
  }
}